#VRML_SIM R2022b utf8

WorldInfo {
  basicTimeStep 32
}

Viewpoint {
  position 8 7 10
  orientation -0.35 0.75 0.55 0.85
}

TexturedBackground {
}

TexturedBackgroundLight {
}

# =========================================================
# GROUND
# =========================================================

Floor {
  size 20 20
  appearance PBRAppearance {
    baseColor 0.45 0.32 0.18
    roughness 1
  }
}

# =========================================================
# COLLECTION CENTRE
# =========================================================

Solid {
  translation -6 0.5 0

  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.5 0.1
        roughness 0.8
      }

      geometry Box {
        size 2 1 2
      }
    }

    Transform {
      translation 0 0.7 0

      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.8 0.1
          }

          geometry Box {
            size 1.5 0.4 1.5
          }
        }
      ]
    }
  ]

  boundingObject Box {
    size 2 1 2
  }
}

# =========================================================
# FARM A
# =========================================================

Solid {
  translation 5 0.5 -4

  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 0.2
      }

      geometry Box {
        size 2 1 2
      }
    }
  ]

  boundingObject Box {
    size 2 1 2
  }
}

# =========================================================
# FARM B
# =========================================================

Solid {
  translation 5 0.5 4

  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 0.2
      }

      geometry Box {
        size 2 1 2
      }
    }
  ]

  boundingObject Box {
    size 2 1 2
  }
}

# =========================================================
# OBSTACLE
# =========================================================

Solid {
  translation 2 0.5 0

  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.15 0.1
      }

      geometry Box {
        size 1 1 2
      }
    }
  ]

  boundingObject Box {
    size 1 1 2
  }
}

# =========================================================
# AGRIROVER
# =========================================================

Robot {
  translation -4 0.35 0
  rotation 0 1 0 0
  name "AgriRover"
  controller "agrirover_controller"

  children [

    # -----------------------------------------------------
    # MAIN BODY
    # -----------------------------------------------------

    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.35 0.8
        roughness 0.6
        metalness 0.2
      }

      geometry Box {
        size 1.8 0.5 1.2
      }
    }

    # -----------------------------------------------------
    # CARGO BOX
    # -----------------------------------------------------

    Transform {
      translation -0.1 0.4 0

      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.85 0.65 0.2
          }

          geometry Box {
            size 1.2 0.3 1
          }
        }
      ]
    }

    # -----------------------------------------------------
    # FRONT LEFT SENSOR
    # -----------------------------------------------------

    DistanceSensor {
      translation 0.95 0.05 -0.35
      rotation 0 1 0 1.5708
      name "front_left_sensor"
      lookupTable [
        0 0 0
        1 1000 0
      ]
    }

    # -----------------------------------------------------
    # FRONT RIGHT SENSOR
    # -----------------------------------------------------

    DistanceSensor {
      translation 0.95 0.05 0.35
      rotation 0 1 0 1.5708
      name "front_right_sensor"
      lookupTable [
        0 0 0
        1 1000 0
      ]
    }

    # =====================================================
    # LEFT FRONT WHEEL
    # =====================================================

    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0.6 -0.15 -0.7
        axis 0 0 1
      }

      device [
        RotationalMotor {
          name "left_front_motor"
          maxVelocity 10
          maxTorque 10
        }
      ]

      endPoint Solid {
        translation 0.6 -0.15 -0.7

        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.05 0.05 0.05
            }

            geometry Cylinder {
              radius 0.3
              height 0.18
            }
          }
        ]

        boundingObject Cylinder {
          radius 0.3
          height 0.18
        }

        physics Physics {
          mass 0.5
        }
      }
    }

    # =====================================================
    # RIGHT FRONT WHEEL
    # =====================================================

    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0.6 -0.15 0.7
        axis 0 0 1
      }

      device [
        RotationalMotor {
          name "right_front_motor"
          maxVelocity 10
          maxTorque 10
        }
      ]

      endPoint Solid {
        translation 0.6 -0.15 0.7

        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.05 0.05 0.05
            }

            geometry Cylinder {
              radius 0.3
              height 0.18
            }
          }
        ]

        boundingObject Cylinder {
          radius 0.3
          height 0.18
        }

        physics Physics {
          mass 0.5
        }
      }
    }

    # =====================================================
    # LEFT REAR WHEEL
    # =====================================================

    HingeJoint {
      jointParameters HingeJointParameters {
        anchor -0.6 -0.15 -0.7
        axis 0 0 1
      }

      device [
        RotationalMotor {
          name "left_rear_motor"
          maxVelocity 10
          maxTorque 10
        }
      ]

      endPoint Solid {
        translation -0.6 -0.15 -0.7

        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.05 0.05 0.05
            }

            geometry Cylinder {
              radius 0.3
              height 0.18
            }
          }
        ]

        boundingObject Cylinder {
          radius 0.3
          height 0.18
        }

        physics Physics {
          mass 0.5
        }
      }
    }

    # =====================================================
    # RIGHT REAR WHEEL
    # =====================================================

    HingeJoint {
      jointParameters HingeJointParameters {
        anchor -0.6 -0.15 0.7
        axis 0 0 1
      }

      device [
        RotationalMotor {
          name "right_rear_motor"
          maxVelocity 10
          maxTorque 10
        }
      ]

      endPoint Solid {
        translation -0.6 -0.15 0.7

        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.05 0.05 0.05
            }

            geometry Cylinder {
              radius 0.3
              height 0.18
            }
          }
        ]

        boundingObject Cylinder {
          radius 0.3
          height 0.18
        }

        physics Physics {
          mass 0.5
        }
      }
    }
  ]

  boundingObject Box {
    size 1.8 0.5 1.2
  }

  physics Physics {
    mass 8
  }
}
